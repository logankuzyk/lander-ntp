{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lander-ntp-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  // Its own subdomain rather than a route on logankuzyk.com, so it works whether or not the
  // website itself goes through Cloudflare's proxy.
  "routes": [{ "pattern": "ntp.logankuzyk.com", "custom_domain": true }],
  "workers_dev": false,
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "lander_ntp_events" }],
  // Per install id. Far above anything the extension sends; only here to blunt abuse.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
