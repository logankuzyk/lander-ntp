{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vitest/globals"]
  },
  // These replace WXT's lists, so they repeat them. `**/*` skips dot-folders, so `.storybook`
  // is named.
  "include": ["**/*", ".wxt/wxt.d.ts", ".storybook/**/*"],
  "exclude": ["**/node_modules", ".output", "storybook-static"]
}
