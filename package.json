{
  "name": "lander-ntp",
  "private": true,
  "version": "0.1.1",
  "description": "A minimal new tab page featuring photography from logankuzyk.com",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:all": "wxt build -b chrome && wxt build -b firefox && wxt build -b edge",
    "zip": "wxt zip",
    "zip:all": "wxt zip -b chrome && wxt zip -b firefox && wxt zip -b edge",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "preact": "^10.29.8",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
